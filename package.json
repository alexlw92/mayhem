{
  "name": "mayhem",
  "version": "1.0.4",
  "description": "ARAM Mayhem stats tracker",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "npm run server:build && electron-vite dev",
    "staging": "cross-env STAGING=true npm run server:build && cross-env STAGING=true electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite dev",
    "test": "vitest run",
    "server:build": "tsc --project tsconfig.server.json",
    "server:start": "node dist-server/server-entry.js",
    "worker:build": "tsc --project tsconfig.worker.json",
    "worker:start": "node dist-worker/src/worker/index.js",
    "dist": "npm run build && electron-builder",
    "db:recalculate-elo": "npm run server:build && node scripts/recalculate-elo.mjs",
    "db:backfill-player-augments": "node scripts/backfill-player-augments.mjs",
    "e2e": "playwright test",
    "prepare": "git config core.hooksPath .githooks"
  },
  "build": {
    "appId": "com.mayhem.stats",
    "productName": "Mayhem Stats",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "portable",
      "icon": "resources/icon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "alexlw92",
      "repo": "mayhem"
    }
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "lru-cache": "^11.5.2",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-roll": "^4.0.0",
    "postgres": "^3.4.9",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^7.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^36.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.2.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^4.1.10"
  }
}
