# ── Database ──────────────────────────────────────────────────────────────────
# Production PostgreSQL (used by the Express backend on EC2)
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Local development PostgreSQL
DATABASE_URL_DEV=postgresql://postgres:postgres@localhost:5432/mayhem

# Test database (used by vitest integration tests)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mayhem_test

# ── Backend ───────────────────────────────────────────────────────────────────
# URL the Electron app uses to reach the Express backend
# Use http://localhost:3847 for local dev; point to EC2 for production builds
BACKEND_URL=http://localhost:3847

# Shared secret between Electron client and Express backend
# Must match on both sides; leave empty to disable auth in local dev
API_KEY=

# Port the Express server listens on (defaults to 3847)
PORT=3847

# ── Release ───────────────────────────────────────────────────────────────────
# GitHub Personal Access Token with repo scope
# Required by release.ps1 to publish a new GitHub Release
GH_TOKEN=
